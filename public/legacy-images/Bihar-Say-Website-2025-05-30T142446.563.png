                function uwp_reset_captcha(element){
                    if(uwp_recaptcha_data.captcha_version == 'v3') {
                        if (typeof grecaptcha != 'undefined') {
                            holderId = grecaptcha.execute(uwp_recaptcha_data.site_key, {action: 'uwp_captcha'}).then(function (token) {
